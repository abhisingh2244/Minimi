{
  "manifest_version": 3,
  "name": "NekoAssist Form Cat",
  "version": "2.0",
  "description": "Krishna images that rotate every 30 minutes while helping fill application forms (text, dropdowns, radios, resume upload) using your locally saved profile.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "krishna.png",
        "krishna2.png",
        "Krishna3.png",
        "krishna4.png",
        "krishna5.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}